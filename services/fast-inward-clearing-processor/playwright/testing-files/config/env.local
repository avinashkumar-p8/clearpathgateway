# Environment variables for Fast Inward Clearing Processor

# Spring Profile
SPRING_PROFILES_ACTIVE=test

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081

# Spanner Configuration
GCP_PROJECT_ID=anz-fastpayment-sg
SPANNER_INSTANCE=payment-gateway
SPANNER_DATABASE=inward-processor-db
SPANNER_EMULATOR_HOST=localhost:9010

# Service Configuration
SERVICE_PORT=8080
SLA_TIMEOUT_SECONDS=4.5

# External Service URLs (for local development)
VAM_ENDPOINT=http://localhost:8445/vam
MIDANZ_ENDPOINT=http://localhost:8446/midanz
LIQUIDITY_SERVICE_URL=http://localhost:8084
SENDER_SERVICE_URL=http://localhost:8083
