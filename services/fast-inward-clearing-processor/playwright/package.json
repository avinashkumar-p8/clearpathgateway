{
  "name": "fast-inward-clearing-processor-playwright",
  "private": true,
  "version": "1.0.0",
  "description": "Playwright test suite for Fast Inward Clearing Processor service",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:auto": "./run-tests.sh",
    "test:auto:headed": "./run-tests.sh --headed",
    "test:auto:pattern": "./run-tests.sh --pattern",
    "test:component": "./run-tests.sh --pattern 'Component Testing'",
    "test:idempotency": "./run-tests.sh --pattern 'IDEMPOTENCY'",
    "test:validation": "./run-tests.sh --pattern 'VALIDATION'",
    "test:agent": "./run-tests.sh --pattern 'AGENT ID'",
    "setup": "./setup-services.sh",
    "cleanup": "./cleanup-services.sh",
    "codegen": "playwright codegen",
    "install-browsers": "playwright install",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@types/node": "^20.11.30",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@kafkajs/confluent-schema-registry": "^3.9.0",
    "axios": "^1.6.0",
    "dotenv": "^16.4.5",
    "kafkajs": "^2.2.4"
  }
}
